# ==================================
# Server Configuration
# ==================================
PORT=5000
NODE_ENV=development

# ==================================
# Database Configuration
# ==================================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/taskmaster

# Docker MongoDB (uncomment if using docker-compose)
# MONGODB_URI=mongodb://admin:password@mongodb:27017/taskmaster?authSource=admin

# MongoDB Atlas (production)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/taskmaster?retryWrites=true&w=majority

# ==================================
# Authentication
# ==================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ==================================
# Email Service (Nodemailer)
# ==================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=TaskMaster <noreply@taskmaster.com>

# ==================================
# Redis Cache Configuration
# ==================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Docker Redis (uncomment if using docker-compose)
# REDIS_HOST=redis
# REDIS_PASSWORD=redispassword

# ==================================
# Firebase Push Notifications
# ==================================
# Option 1: Service Account JSON Path
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option 2: Individual Credentials
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com

# ==================================
# File Upload Configuration
# ==================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ==================================
# Rate Limiting
# ==================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==================================
# Payment Configuration (Future)
# ==================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# MOMO_PARTNER_CODE=...
# ZALOPAY_APP_ID=...

# ==================================
# Application URLs
# ==================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ==================================
# Logging
# ==================================
LOG_LEVEL=info
LOG_DIR=logs

# ==================================
# Security
# ==================================
CORS_ORIGIN=*
BCRYPT_ROUNDS=10

# ==================================
# Session Configuration
# ==================================
SESSION_SECRET=your_session_secret_key_change_this

# ==================================
# Admin Configuration
# ==================================
ADMIN_EMAIL=admin@taskmaster.com
ADMIN_PASSWORD=change_this_admin_password

# ==================================
# Background Jobs (Bull Queue)
# ==================================
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=

# ==================================
# Monitoring & Analytics
# ==================================
# SENTRY_DSN=https://your-sentry-dsn
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# ==================================
# Development & Testing
# ==================================
DEBUG=false
ENABLE_SWAGGER=true
